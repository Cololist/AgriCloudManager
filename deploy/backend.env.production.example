PORT=3000
SQLITE_PATH=./data/agricloud.sqlite

# Generate a private random value before deployment.
JWT_SECRET=
NODE_ENV=production
CORS_ORIGIN=https://ysngj.cn
SMS_LOGIN_ENABLED=false
PUBLIC_REGISTRATION_ENABLED=false
ACCESS_TOKEN_TTL_SECONDS=86400
REFRESH_TOKEN_TTL_SECONDS=604800

DEFAULT_ACCOUNT_PHONE=
DEFAULT_ACCOUNT_PASSWORD=
DEFAULT_ACCOUNT_NICKNAME=种植户

AMAP_WEB_SERVICE_KEY=
AMAP_DEFAULT_ADCODE=370602
WEATHER_CACHE_TTL_MINUTES=30

AI_PROVIDER=vivo-xuanji
VIVO_APP_ID=
VIVO_APP_KEY=
VIVO_XUANJI_API_URL=https://api-ai.vivo.com.cn/v1/chat/completions
VIVO_TEXT_MODEL=Doubao-Seed-2.0-mini
VIVO_VL_MODEL=Doubao-Seed-2.0-mini
VIVO_VL_FALLBACK_MODELS=Doubao-Seed-2.0-mini,Volc-DeepSeek-V3.2
VIVO_ASR_WS_URL=wss://api-ai.vivo.com.cn/asr/v2
VIVO_ASR_ENGINE_ID=shortasrinput
VIVO_TTS_WS_URL=wss://api-ai.vivo.com.cn/tts
VIVO_TTS_ENGINE_ID=short_audio_synthesis_jovi
VIVO_TTS_VOICE=vivoHelper
VIVO_TTS_PACKAGE=cn.ysngj.agricloud
AI_TIMEOUT_MS=60000
AI_ENABLE_THINKING=true
AI_DIAGNOSIS_ENABLE_THINKING=false
AI_MARKET_ENABLE_THINKING=false
AI_MARKETING_ENABLE_THINKING=false

MARKET_REPORT_AI_ENABLED=true
MARKET_REPORT_AI_TIMEOUT_MS=60000

# Minimal production deployment: use the built-in search and forecast fallbacks.
LIGHTRAG_ENABLED=false
SCHEDULER_ENABLED=true
MODEL_SERVICE_SHARED_SECRET=

OSS_ENDPOINT=oss-cn-hongkong.aliyuncs.com
# Leave blank until img.ysngj.cn has a valid HTTPS certificate.
OSS_PUBLIC_HOST=
OSS_BUCKET=test-spiong
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_UPLOAD_PREFIX=agricloud/uploads/
OSS_MAX_SIZE_MB=10
