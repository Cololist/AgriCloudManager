PORT=3000
SQLITE_PATH=./data/agricloud.sqlite

JWT_SECRET=please-change-this-demo-secret
ACCESS_TOKEN_TTL_SECONDS=86400
REFRESH_TOKEN_TTL_SECONDS=604800

DEFAULT_ACCOUNT_PHONE=
DEFAULT_ACCOUNT_PASSWORD=
DEFAULT_ACCOUNT_NICKNAME=种植户

AMAP_WEB_SERVICE_KEY=
AMAP_DEFAULT_ADCODE=370602
WEATHER_CACHE_TTL_MINUTES=30

AI_PROVIDER=vivo-xuanji
VIVO_APP_ID=
VIVO_APP_KEY=
VIVO_XUANJI_API_URL=https://api-ai.vivo.com.cn/v1/chat/completions
VIVO_TEXT_MODEL=Doubao-Seed-2.0-mini
VIVO_VL_MODEL=Doubao-Seed-2.0-mini
VIVO_VL_FALLBACK_MODELS=Doubao-Seed-2.0-mini,Volc-DeepSeek-V3.2
AI_TIMEOUT_MS=15000

# Legacy DashScope fallback; leave empty when using vivo-xuanji.
DASHSCOPE_API_KEY=
DASHSCOPE_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
DASHSCOPE_TEXT_MODEL=qwen3.6-flash
DASHSCOPE_VL_MODEL=qwen-vl-max-latest
DASHSCOPE_ENABLE_THINKING=true

MARKET_REPORT_AI_ENABLED=true
MARKET_REPORT_AI_TIMEOUT_MS=60000
DASHSCOPE_MARKET_ENABLE_THINKING=false
LIGHTRAG_ENABLED=false
LIGHTRAG_BASE_URL=http://127.0.0.1:9621
LIGHTRAG_API_KEY=
LIGHTRAG_QUERY_MODE=mix
LIGHTRAG_TIMEOUT_MS=120000
LIGHTRAG_TOP_K=10
LIGHTRAG_CHUNK_TOP_K=8

OSS_ENDPOINT=oss-cn-hongkong.aliyuncs.com
OSS_PUBLIC_HOST=img.ysngj.cn
OSS_BUCKET=test-spiong
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_UPLOAD_PREFIX=agricloud/uploads/
OSS_MAX_SIZE_MB=10

# === market-price-forecast (Phase 1) ===
# Independent Python Model_Service URL（内网/VPN 部署，不暴露公网）
MODEL_SERVICE_BASE_URL=http://127.0.0.1:8000
# 与 model-service/.env 中 FORECAST_SHARED_SECRET 必须一致
MODEL_SERVICE_SHARED_SECRET=
MODEL_SERVICE_TIMEOUT_MS=30000
MODEL_SERVICE_CONCURRENCY=8
# Collector User-Agent 中的项目标识与联系邮箱（Requirement 12.1）
FORECAST_PROJECT_TAG=AgriCloudManager-Forecast/1.0
FORECAST_CONTACT_EMAIL=ops@ysngj.cn
# 调度器开关；测试或维护期可临时关闭
SCHEDULER_ENABLED=true
# 灰度白名单（spu_id 逗号分隔）；为空表示对所有 active SPU 启用真实预测
FORECAST_FEATURE_SPUS=
