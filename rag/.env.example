# LightRAG server
HOST=127.0.0.1
PORT=9621
WORKSPACE=agricloud-market
SUMMARY_LANGUAGE=Chinese
ENABLE_LLM_CACHE_FOR_EXTRACT=true
MAX_PARALLEL_INSERT=1
MAX_ASYNC=2
TIMEOUT=180

# Use local file storage for a 2c4g demo server.
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage

# DashScope OpenAI-compatible chat.
LLM_BINDING=openai
LLM_MODEL=qwen3.6-flash
LLM_BINDING_HOST=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BINDING_API_KEY=
OPENAI_LLM_MAX_TOKENS=9000
OPENAI_LLM_EXTRA_BODY={"enable_thinking":false}

# DashScope OpenAI-compatible embeddings.
# text-embedding-v4 defaults to 1024 dimensions unless configured otherwise.
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_BINDING_HOST=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_BINDING_API_KEY=

# Keep demo deployment simple. Rerank can be enabled later after cost/latency testing.
RERANK_BY_DEFAULT=False

# Internal API key between Node backend and LightRAG.
LIGHTRAG_API_KEY=please-change-this-rag-key
WHITELIST_PATHS=/health
